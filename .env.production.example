# Production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   $EDITOR .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production config   # verify
#
# This file is gitignored (`.env.*` is ignored with an `!.env.example` exception).
# Never commit a filled-in copy: it holds the key that decrypts agent wallets.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_DB=hyperdash
POSTGRES_USER=postgres
# openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Agent-wallet key material — TREAT AS A PRODUCTION SECRET
# ---------------------------------------------------------------------------
# openssl rand -hex 32
#
# MUST be byte-identical to the value set on the api Worker:
#   bunx wrangler secret put ENCRYPTION_KEY   # in apps/api, paste the same value
#
# The BE encrypts agent (API wallet) private keys at rest and the copier decrypts
# them to sign orders. A mismatch is NOT caught at boot: it surfaces as a
# decryption failure the first time an order needs signing.
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ---------------------------------------------------------------------------
# Execution mode
# ---------------------------------------------------------------------------
# Anything other than 1 runs the full pipeline against live market data with
# simulated fills. Leave at 0 until the pipeline is verified end to end.
LIVE=0

# 0 = mainnet, 1 = testnet. Must match the api Worker's HYPERLIQUID_TESTNET:
# signing for one network and submitting to the other is rejected by the
# exchange, at order time rather than at boot.
HYPERLIQUID_TESTNET=0
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# ---------------------------------------------------------------------------
# Reconciler tuning (defaults match apps/copier/src/config.ts)
# ---------------------------------------------------------------------------
# Hyperliquid enforces a $10 minimum notional, so the deadband starts there.
MIN_ORDER_USD=10
# Skip deltas below this share of the target position.
DRIFT_THRESHOLD_PCT=1
# Full sweep — the safety net for dropped websocket events.
SWEEP_INTERVAL_MS=60000
STRATEGY_REFRESH_MS=15000
DEFAULT_SLIPPAGE_BPS=10
DEFAULT_MAX_POSITION_USD=1000
MAX_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Copy engine (Go) risk bounds
# ---------------------------------------------------------------------------
MAX_LEVERAGE=10
MAX_POSITION_SIZE=10000
MIN_ORDER_SIZE=10
MAX_SLIPPAGE=0.01

# ---------------------------------------------------------------------------
# Ingest
# ---------------------------------------------------------------------------
INGEST_PORT=3001
# Shared secret for the whale-discovery cron -> BE job endpoint.
#   openssl rand -hex 32
# Must match JOBS_SECRET on the api Worker.
JOBS_SECRET=CHANGE_ME
# Comma-separated whale wallets to track. Empty disables the whale-flow panel.
HL_WHALE_ADDRESSES=
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Builder code (optional fee attribution)
# ---------------------------------------------------------------------------
BUILDER_ADDRESS=
BUILDER_FEE_RATE=0.01%

# ---------------------------------------------------------------------------
# Observability (only used with --profile observability)
# ---------------------------------------------------------------------------
GRAFANA_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Image tag for locally built images
# ---------------------------------------------------------------------------
IMAGE_TAG=latest
