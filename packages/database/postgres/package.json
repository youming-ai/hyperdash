{
  "name": "@hyperdash/postgres",
  "version": "1.0.0",
  "description": "PostgreSQL database schemas and migrations for HyperDash platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "migrate": "bun src/migrate.ts",
    "migrate:generate": "drizzle-kit generate",
    "migrate:push": "bun push-migration.ts",
    "seed": "bun seed.ts",
    "studio": "drizzle-kit studio",
    "type-check": "tsc --noEmit",
    "db:push": "drizzle-kit push --force"
  },
  "dependencies": {
    "@hyperdash/shared-types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.3.3"
  }
}
