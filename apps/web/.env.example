# Client-safe values only (VITE_ prefix). Server secrets live in Worker bindings
# (wrangler.toml [vars]) and `.dev.vars` / `wrangler secret put` — never here.

# Public origin used by the Hono RPC client during SSR.
VITE_PUBLIC_ORIGIN=http://localhost:5173

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here


# Real-time feed: WebSocket endpoint of the ingest service (dev default port 3001).
# Point this at the deployed ingest service in production (e.g. wss://ingest.yourhost.com/ws).
VITE_WS_URL=ws://localhost:3001/ws

# Feed REST history base (`/feed/history/*`, `/feed/whales`).
#
# These routes are NOT served by the ingest WS hub above — they live in the
# api-gateway service. Leave unset only if the history routes share the
# VITE_WS_URL host; otherwise the analytics heatmaps will report an error.
# VITE_FEED_REST_URL=http://localhost:3000

# Backend Worker base URL. Required for endpoints that only exist in the BE —
# notably /api/agent-wallets, which holds the encryption key and generates agent
# keypairs and therefore must not run in the frontend Worker.
#
# - BE running separately (bun run dev:api, port 5174): set this so the browser
#   calls it directly. Cross-origin cookies require apps/web/.dev.vars BE_URL too
#   (see that file).
# - FE/BE co-located: leave unset; only the routes copied into this app work, and
#   the agent-wallet panel will report an error until BE_URL is configured.
VITE_BE_URL=http://localhost:5174
