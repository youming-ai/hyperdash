# Client-safe values only (VITE_ prefix). Server secrets live in Worker bindings
# (wrangler.toml [vars]) and `.dev.vars` / `wrangler secret put` — never here.

# Public origin used by the Hono RPC client during SSR.
VITE_PUBLIC_ORIGIN=http://localhost:5173

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here


# Real-time feed: WebSocket endpoint of the api-gateway feed hub (dev default).
# Point this at the deployed api-gateway in production (e.g. wss://api.yourhost.com/ws).
VITE_WS_URL=ws://localhost:3000/ws
