{
  "name": "@hyperdash/api-gateway",
  "version": "1.0.0",
  "description": "API Gateway with tRPC and WebSocket support for HyperDash platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env dist/index.js",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "ingest:traders": "bun --env-file=../../.env scripts/ingest-traders.ts"
  },
  "dependencies": {
    "@hyperdash/contracts": "workspace:*",
    "@hyperdash/database": "workspace:*",
    "@hyperdash/shared-types": "workspace:*",
    "@trpc/server": "^10.43.6",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jose": "^5.1.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "openai": "^4.0.0",
    "postgres": "^3.4.9",
    "superjson": "^2.2.1",
    "viem": "^2.0.0",
    "ws": "^8.14.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
