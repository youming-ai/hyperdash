# Ingest service env (Bun auto-loads .env). Copy to .env and fill in.

# Health/metrics HTTP + WebSocket port (default 3001).
PORT=3001

# Hyperliquid WS gateway (default wss://api.hyperliquid.xyz/ws).
# HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# Redis for feed history (FeedRecorder). Without it the pipeline still runs,
# history just isn't persisted.
# REDIS_URL=redis://localhost:6379

# BE Worker (apps/api) that the whale-discovery cron POSTs to.
# Without it the cron only logs. `cd apps/api && bun run dev` serves this.
BE_URL=http://localhost:5174

# Shared secret for BE job endpoints — must match JOBS_SECRET on apps/api
# (`wrangler secret put JOBS_SECRET` / .dev.vars). Without it BE returns 403.
# JOBS_SECRET=change-me
