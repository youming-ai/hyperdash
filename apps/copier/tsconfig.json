{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["bun", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "drizzle-orm": ["../../packages/database/postgres/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../../packages/database/postgres/node_modules/drizzle-orm/*"],
      "postgres": ["../../packages/database/postgres/node_modules/postgres"],
      "postgres/*": ["../../packages/database/postgres/node_modules/postgres/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
