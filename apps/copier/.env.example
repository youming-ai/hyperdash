# Copy-trading execution plane
# Postgres + Redis are expected to be running (bun run docker:up from repo root)

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hyperdash

# 32-byte hex key for agent private-key encryption. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# --- execution mode -------------------------------------------------------
# Anything other than 1 runs in paper mode: the full pipeline executes against
# live market data with simulated fills. Recommended until verified.
LIVE=0

# Required when LIVE=1
AGENT_PRIVATE_KEY=
MASTER_ADDRESS=

# --- reconciler tuning ----------------------------------------------------
# Hyperliquid enforces a $10 minimum notional, so the deadband starts there.
MIN_ORDER_USD=10
# Ignore drift smaller than this share of the target position.
DRIFT_THRESHOLD_PCT=1
# Full reconciliation period (the safety net for missed websocket events).
SWEEP_INTERVAL_MS=60000
# How often active strategies are reloaded from Postgres.
STRATEGY_REFRESH_MS=15000
DEFAULT_SLIPPAGE_BPS=10
DEFAULT_MAX_POSITION_USD=1000

# --- builder code (revenue) ----------------------------------------------
BUILDER_ADDRESS=
BUILDER_FEE_RATE=0.01%

HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_TESTNET=0
LOG_LEVEL=info
